# ==========================================
# AgroVenda V2 - Configurações de Produção / VPS
# ==========================================

# Aplicação Node.js Express
NODE_ENV=production
PORT=3000

# Conexão MongoDB Interna
MONGO_URI=mongodb://mongodb:27017/agrovenda

# Segurança & Criptografia JWT
JWT_SECRET=agrovenda_super_secure_jwt_secret_2026_agro_v2

# Mongo Express Web GUI (Protegido por Autenticação Básica)
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASS=AgroAdmin2026!

# Integração Externa de Automação (n8n / Google Calendar)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/agrovenda-sales
