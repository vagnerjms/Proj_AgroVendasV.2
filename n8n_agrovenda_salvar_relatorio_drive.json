        "jsCode": "const body = $('Webhook Relatorio AgroVenda').first().json.body || {};\nconst folderId = $('Criar ou Usar Pasta Relatorios no Drive').first().json.id;\nconst fileName = body.fileName || `Relatorio_AgroVenda_${new Date().toISOString().split('T')[0]}.xls`;\nconst contentBase64 = body.contentBase64 || (body.files && body.files[0] ? body.files[0].contentBase64 : '');\n\nif (!contentBase64) {\n  throw new Error('Conteudo do arquivo nao foi recebido no webhook.');\n}\n\nconst fileBuffer = Buffer.from(contentBase64, 'base64');\n\nreturn [{\n  json: {\n    fileName: fileName,\n    folderId: folderId,\n    fileSize: fileBuffer.length,\n    filters: body.filters\n  },\n  binary: {\n    data: await this.helpers.prepareBinaryData(\n      fileBuffer,\n      fileName,\n      'application/vnd.ms-excel'\n    )\n  }\n}];"
      },
