          },
          "conditions": [
            {
              "id": "has_files_condition",
              "leftValue": "={{ $json.body.hasFiles }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        80,
        140
      ],
      "id": "20000000-if-4000-8000-000000000003",
      "name": "Possui Arquivos/NFs?"
    },
    {
      "parameters": {
        "resource": "folder",
        "name": "={{ $('Webhook AgroVenda').first().json.body.driveFolder.suggestedFolder }}",
        "options": {
          "parentFolderId": {
            "__rl": true,
            "value": "1eUU4Vhg325_NtF19i_4tCQwVVOXFefeq",
            "mode": "id"
          }
        }
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        320,
        140
      ],
      "id": "20000000-folder-4000-8000-000000000004",
      "name": "Criar ou Usar Pasta da Loja no Drive",
      "credentials": {
        "googleDriveOAuth2": {
          "id": "Google Drive account",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const webhookBody = $('Webhook AgroVenda').first().json.body || {};\nconst files = webhookBody.files || [];\nconst folderId = $('Criar ou Usar Pasta da Loja no Drive').first().json.id;\n\nconst results = [];\nfor (const f of files) {\n  if (f.contentBase64 && f.sizeBytes > 0) {\n    const fileBuffer = Buffer.from(f.contentBase64, 'base64');\n    results.push({\n      json: {\n        fileName: f.filename,\n        folderId: folderId,\n        client: webhookBody.client,\n        saleId: webhookBody.saleId\n      },\n      binary: {\n        data: await this.helpers.prepareBinaryData(\n          fileBuffer,\n          f.filename,\n          f.mimeType || 'application/pdf'\n        )\n      }\n    });\n  }\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        140
      ],
      "id": "20000000-code-4000-8000-000000000005",
      "name": "Extrair Arquivos Binários da Venda"
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "upload",
        "fileContent": "data",
        "options": {
          "fileName": "={{ $json.fileName }}",
          "folderId": {
            "__rl": true,
            "value": "={{ $json.folderId }}",
            "mode": "id"
          }
        }
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        800,
        140
      ],
      "id": "20000000-upload-4000-8000-000000000006",
      "name": "Salvar Arquivo Dentro da Pasta Criada",
      "credentials": {
        "googleDriveOAuth2": {
          "id": "Google Drive account",
          "name": "Google Drive account"
        }
      }
    }
  ],
